      left=10pt,
      right=0pt,
      top=8pt,
      bottom=8pt,
      before skip=0pt,
      after skip=0pt,
      mixable={probline}{probback},
      fonttitle=\titlefont\bfseries,
      attach title to upper,
      after title={\enspace},
    },
  % New Environments
  myobjective/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={objline}{objback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  myintuition/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={intline}{intback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  myalgorithm/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={algline}{algback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  myapplication/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={appline}{appback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  myhistory/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={histline}{histback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  mypitfall/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={pitfallline}{pitfallback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  myreference/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={refline}{refback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
  mysummary/.style={enhanced, breakable, boxrule=0pt, frame hidden, arc=0pt, left=10pt, right=0pt, top=8pt, bottom=8pt, before skip=0pt, after skip=0pt, mixable={sumline}{sumback}, fonttitle=\titlefont\bfseries, attach title to upper, after title={\enspace}},
