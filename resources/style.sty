\newcommand{\nestedgapfill}{%
  \fill[parentbackcolor, draw=none] (frame.south west) rectangle ([xshift=13pt]frame.north west);
  \fill[parentlinecolor, draw=none] (frame.south west) rectangle ([xshift=3pt]frame.north west);
}

\newcommand{\setlastclosedbox}[2]{%
  \xglobal\colorlet{lastclosedboxline}{#1}%
  \xglobal\colorlet{lastclosedboxback}{#2}%
  \ifdefstring{\isnestedbox}{true}{%
    \gdef\afternestedbox{true}%
  }{%
    \gdef\afternestedbox{false}%
  }%
}

% ==============================================================================
%                              Beautiful Boxes
% ==============================================================================
\RequirePackage[most]{tcolorbox}

% Helper: apply environment color overrides for lists and bold text.
% Must be called INSIDE the box body (after \begin{<box>}[...]).
\newcommand{\applyenvcolor}[1]{%
  \boolfalse{isnestedboxbool}%
  \ifnum\value{tcblayer}>1\relax
    \booltrue{isnestedboxbool}%
  \fi
  \ifdefstring{\isnestedbox}{true}{%
    \booltrue{isnestedboxbool}%
  }{}%
  \ifbool{isnestedboxbool}{%
    \renewcommand{\envcolorname}{mixedline}%
    \setlist[itemize]{label={\color{mixedline}\textbullet}}%
    \setlist[enumerate]{label={\color{mixedline}\bfseries\arabic*)}}%
    \hypersetup{linkcolor=mixedline, citecolor=mixedline, urlcolor=mixedline}%
  }{%
    \renewcommand{\envcolorname}{#1}%
    \setlist[itemize]{label={\color{#1}\textbullet}}%
    \setlist[enumerate]{label={\color{#1}\bfseries\arabic*)}}%
    \hypersetup{linkcolor=#1, citecolor=#1, urlcolor=#1}%
  }%
}

% Colored bold text: \textbf picks up \envcolorname
\let\origtextbf\textbf
\renewcommand{\textbf}[1]{{\bfseries\color{\envcolorname}#1}}

\tcbset{
  parbox=false,
  every box on layer 2/.append style={parbox=false},
  every box on layer 3/.append style={parbox=false},
  every box on layer 4/.append style={parbox=false},
  % Mixable style for nested boxes
  mixable/.style 2 args={%
    code={%
      \boolfalse{isnestedboxbool}%
      \ifnum\value{tcblayer}>1\relax
        \booltrue{isnestedboxbool}%
      \fi
      \ifdefstring{\isnestedbox}{true}{%
        \booltrue{isnestedboxbool}%
      }{}%
      \ifbool{isnestedboxbool}{%
        \xglobal\colorlet{mixedline}{#1!50!parentlinecolor}%
        \xglobal\colorlet{mixedborder}{mixedline!50!white}%
        \xglobal\colorlet{mixedback}{mixedline!18!white}%
        \tcbset{
          enhanced,
          enforce breakable,
          boxrule=0pt,
          frame hidden,
          arc=0pt,
          left=23pt,
          right=0pt,
          borderline west={3pt}{13pt}{mixedborder},
          interior style={left color=mixedback, right color=white, draw=none},
          underlay unbroken=\nestedgapfill,
          underlay first=\nestedgapfill,
          underlay middle=\nestedgapfill,
          underlay last=\nestedgapfill,
          coltitle=mixedline!85!black,
          before skip=-\dimexpr\parskip\relax,
        }%
        \ifdefstring{\afternestedbox}{true}{%
          \tcbset{top=3pt}%
        }{%
          \tcbset{top=8pt}%
        }%
        \ifdefstring{\nextisnested}{true}{%
          \tcbset{bottom=6pt}%
        }{%
          \tcbset{bottom=8pt}%
        }%
        \gdef\afternestedbox{true}%
      }{%
        \tcbset{
          borderline west={3pt}{0pt}{#1},
          interior style={left color=#2, right color=white},
          coltitle=#1!85!black,
          before skip=0pt,
          after skip=0pt,
          top=8pt,
          bottom=8pt,
        }%
        \gdef\afternestedbox{false}%
      }%
      \def\parentline{#1}%
      \def\parentback{#2}%
    }%
  },
  % Theorem style
  mythm/.style={
      enhanced,
      breakable,
      boxrule=0pt,
      frame hidden,
      arc=0pt,
      left=10pt,
      right=0pt,
      top=8pt,
      bottom=8pt,
      before skip=0pt,
      after skip=0pt,
      mixable={thmline}{thmback},
      fonttitle=\titlefont\bfseries,
      attach title to upper,
      after title={\enspace},
    },
  % Definition style  
  mydef/.style={
      enhanced,
      breakable,
      boxrule=0pt,
      frame hidden,
      arc=0pt,
      left=10pt,
      right=0pt,
      top=8pt,
      bottom=8pt,
      before skip=0pt,
      after skip=0pt,
      mixable={defline}{defback},
      fonttitle=\titlefont\bfseries,
      attach title to upper,
      after title={\enspace},
    },
  % Note style
  mynote/.style={
      enhanced,
      breakable,
      boxrule=0pt,
      frame hidden,
      arc=0pt,
      left=10pt,
      right=0pt,
      top=8pt,
      bottom=8pt,
      before skip=0pt,
      after skip=0pt,
      mixable={noteline}{noteback},
      fonttitle=\titlefont\bfseries,
      attach title to upper,
      after title={\enspace},
    },
  myproof/.style={
      enhanced,
      enforce breakable,
      lines before break=1,
      boxrule=0pt,
      frame hidden,
      arc=0pt,
      left=10pt,
      right=0pt,
      top=8pt,
      bottom=8pt,
      before skip=0pt,
      after skip=0pt,
      fontupper=\small,
      code={%
        \boolfalse{isnestedboxbool}%
