% Sekce uvnitř boxu „Jak uspět`` --- seznam bez odrážek. Svislé oddělení dělá
% seznam, nikoli odstavcové zlomy, takže je nezávislé na tom, jak se s~tělem
% boxu vypořádá nested_parser.lua.

% Run-in nadpis uvnitř boxu „Jak uspět“.
%
% Musí být v \mbox, nikoli jen v {}: breakable tcolorbox dělí obsah pomocí
% \vsplit a barevný whatsit, který stojí na začátku prvního odstavce
% pokračovacího fragmentu, se přitom ztratí --- nadpis pak vyjde černě.
% (Proto zůstávají obarvené odrážky a čísla položek: ty jsou uvnitř labelboxu
% seznamu, tedy uvnitř hboxu, který \vsplit nerozebírá.) Zabalením do \mbox
% je push i pop barvy uzavřen v jednom nedělitelném hboxu a přechod přes
% stránku přežije. Nadpisy jsou krátké (max ~37 znaků), takže zákaz zlomu
% uvnitř nevadí.
%
% Barva je navíc zapsána doslovně, ne přes \envcolorname: ten se v \textbf
% expanduje až v místě užití, takže se může rozejít s barvou boxu.
\newcommand{\exlabel}[1]{\mbox{\bfseries\color{examline!90!black}#1}}
\newenvironment{examparts}
  {\begin{list}{}{%
      \setlength{\leftmargin}{0pt}%
      \setlength{\rightmargin}{0pt}%
      \setlength{\labelwidth}{0pt}%
      \setlength{\labelsep}{0pt}%
      \setlength{\itemindent}{0pt}%
      \setlength{\listparindent}{0pt}%
      \setlength{\topsep}{0.5em}%
      \setlength{\partopsep}{0pt}%
      \setlength{\parsep}{0pt}%
      \setlength{\itemsep}{0.5em}%
      \renewcommand{\makelabel}[1]{}%
   }}
  {\end{list}}

\NewDocumentEnvironment{exam}{ O{} +b }
  {\directlua{nested_parser.process_nested_env("exam", false, \luastringN{#1}, \luastringN{#2}, "\isnestedbox")}}{}

