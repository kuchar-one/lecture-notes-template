% Redefine section and chapter marks for book class
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{§\,\thesection\quad#1}}

% Bibliography heading fix (avoid uppercase in headers)
\defbibheading{bibliography}[\refname]{%
  \section*{#1}%
  \markboth{#1}{#1}}

% Part styling
\titleformat{\part}[display]
{\normalfont\Huge\titlefont\bfseries\color{accentdark}\filcenter}
{\partname~\thepart}{0.5em}{}
[\vspace{0.5em}{\color{rulecolor}\titlerule[2pt]}]

% Chapter styling
\titleformat{\chapter}[display]
{\normalfont\Huge\titlefont\bfseries\color{accentdark}}
{\chaptertitlename~\thechapter}{0.5em}{}
[\vspace{0.5em}{\color{rulecolor}\titlerule[2pt]}]

% Section styling
\titleformat{\section}
{\normalfont\Large\titlefont\bfseries\color{accentdark}}
{§\,\thesection}{1em}{}
[\vspace{0.3em}{\color{rulecolor}\titlerule[1pt]}]

\titleformat{\subsection}
{\normalfont\large\titlefont\bfseries\color{accent}}
{§\,\thesubsection}{0.6em}{}

\titleformat{\subsubsection}
{\normalfont\normalsize\titlefont\bfseries\color{accent!85!black}}
{§\,\thesubsubsection}{0.5em}{}

\titlespacing*{\chapter}{0pt}{-1em}{2em}
\titlespacing*{\section}{0pt}{1.2em}{0.4em}
\titlespacing*{\subsection}{0pt}{0.4em}{-0.2em}
\titlespacing*{\subsubsection}{0pt}{0.4em}{-0.2em}

% Otázky plynou plynule za sebou --- žádný \clearpage před \section.
% Záporná penalta jen \emph{nabízí} zlom na hranici otázek: když se nová otázka
% na zbytek stránky stejně nevejde, TeX ji odsune, jinak naváže hned.
% (Nadpis nemůže zůstat osamocen dole: \@afterheading za ním drží první řádek
% nekonečnou penaltou.)
\newcommand{\sectionbreak}{\par\penalty-300\relax}
% Stránku lámeme jen před částmi. Pro jistotu je \clearpage navíc explicitně
% i v main.tex, protože podpora hooku \partbreak se mezi verzemi titlesec liší;
% druhý \clearpage na čisté stránce nic nedělá.
\newcommand{\partbreak}{\clearpage}



% ==============================================================================
