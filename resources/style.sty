\newtcolorbox{solutionbox}[1][]{mysolution, #1}

\renewenvironment{proof}[1][\proofenvname]{%
  \boolfalse{isnestedboxbool}%
  \ifnum\value{tcblayer}>1\relax
    \booltrue{isnestedboxbool}%
  \fi
  \ifdefstring{\isnestedbox}{true}{%
    \booltrue{isnestedboxbool}%
  }{}%
  \ifbool{isnestedboxbool}{%
    \colorlet{proofcolor}{thmline!50!parentlinecolor}%
  }{%
    \colorlet{proofcolor}{thmline}%
  }%
  \begin{proofbox}%
  \applyenvcolor{proofcolor}%
  {\titlefont\itshape\color{proofcolor}#1.}\enspace\ignorespaces
}{%
  \par\nopagebreak\vspace{0.3em}\hfill{\color{proofcolor}\ensuremath{\blacksquare}}\par
  \end{proofbox}%
  \setlastclosedbox{thmline}{thmback}%
}

\newenvironment{solution}[1][\solutionname]{%
  \boolfalse{isnestedboxbool}%
  \ifnum\value{tcblayer}>1\relax
    \booltrue{isnestedboxbool}%
  \fi
  \ifdefstring{\isnestedbox}{true}{%
    \booltrue{isnestedboxbool}%
  }{}%
  \ifbool{isnestedboxbool}{%
    \colorlet{solcolor}{probline!50!parentlinecolor}%
  }{%
    \colorlet{solcolor}{probline}%
  }%
  \begin{solutionbox}%
  \applyenvcolor{solcolor}%
  {\titlefont\itshape\color{solcolor}#1.}\enspace\ignorespaces
}{%
  \par
  \end{solutionbox}%
  \setlastclosedbox{probline}{probback}%
}

% Visual Nesting environments (to solve breakability issues of nested boxes)
\newtcolorbox{nestedproofbox}[1][]{
  enhanced,
  enforce breakable,
  nobeforeafter,
  ignore nobreak,
  boxrule=0pt,
  frame hidden,
  code={%
    \xglobal\colorlet{mixedline}{thmline!50!parentlinecolor}%
    \xglobal\colorlet{mixedborder}{mixedline!50!white}%
    \xglobal\colorlet{mixedback}{mixedline!18!white}%
    \tcbset{
      borderline west={3pt}{0pt}{parentlinecolor},
      borderline west={3pt}{13pt}{mixedborder},
      interior style={left color=mixedback, right color=white, draw=none},
      underlay unbroken=\nestedgapfill,
      underlay first=\nestedgapfill,
      underlay middle=\nestedgapfill,
      underlay last=\nestedgapfill
    }%
  },
  arc=0pt,
  left=23pt,
  right=0pt,
  top=8pt,
  bottom=8pt,
  after skip=0pt,
  fontupper=\small,
  #1
}

\newenvironment{nestedproof}[1][\proofenvname]{%
  \colorlet{proofmixcolor}{thmline!50!parentlinecolor}%
  \begin{nestedproofbox}%
  \applyenvcolor{proofmixcolor}%
  {\titlefont\itshape\color{proofmixcolor}#1.}\enspace\ignorespaces
}{%
  \par\nopagebreak\vspace{0.3em}\hfill{\color{proofmixcolor}\ensuremath{\blacksquare}}\par
  \end{nestedproofbox}%
}

\newtcolorbox{nestedsolutionbox}[1][]{
  enhanced,
  enforce breakable,
  nobeforeafter,
  ignore nobreak,
  boxrule=0pt,
  frame hidden,
  code={%
    \xglobal\colorlet{mixedline}{probline!50!parentlinecolor}%
    \xglobal\colorlet{mixedborder}{mixedline!50!white}%
    \xglobal\colorlet{mixedback}{mixedline!18!white}%
    \tcbset{
      borderline west={3pt}{0pt}{parentlinecolor},
      borderline west={3pt}{13pt}{mixedborder},
      interior style={left color=mixedback, right color=white, draw=none},
      underlay unbroken=\nestedgapfill,
      underlay first=\nestedgapfill,
      underlay middle=\nestedgapfill,
      underlay last=\nestedgapfill
    }%
  },
  arc=0pt,
  left=23pt,
  right=0pt,
  top=8pt,
  bottom=8pt,
  before skip=-\dimexpr\parskip\relax,
  after skip=0pt,
  fontupper=\small,
  #1
}

\newenvironment{nestedsolution}[1][\solutionname]{%
  \colorlet{solmixcolor}{probline!50!parentlinecolor}%
  \begin{nestedsolutionbox}%
  \applyenvcolor{solmixcolor}%
  {\titlefont\itshape\color{solmixcolor}#1.}\enspace\ignorespaces
}{%
  \par
  \end{nestedsolutionbox}%
}

% Overview box for section summaries
\newtcolorbox{overviewbox}[1][]{
  enhanced,
  boxrule=0pt,
  leftrule=3pt,
  rightrule=0pt,
  toprule=1.5pt,
  bottomrule=1.5pt,
  arc=0pt,
  outer arc=0pt,
  colframe=accent,
  interior style={left color=accent!5, right color=white},
  title={\overviewname},
  coltitle=accentdark,
  fonttitle=\bfseries\sffamily,
  attach boxed title to top left={yshift=-\tcboxedtitleheight/2, xshift=5mm},
  boxed title style={
      interior style={top color=white, bottom color=accent!5},
      frame hidden,
    },
  after skip=0pt,
  #1
}

\newtcolorbox{termsbox}[1][]{
  enhanced,
  breakable,
  boxrule=0pt,
  leftrule=3pt,
  rightrule=0pt,
  toprule=1.5pt,
  bottomrule=1.5pt,
  arc=0pt,
  outer arc=0pt,
  colframe=accent,
  interior style={left color=accent!5, right color=white},
  title={\termsname},
  coltitle=accentdark,
  fonttitle=\bfseries\sffamily,
  attach boxed title to top left={yshift=-\tcboxedtitleheight/2, xshift=5mm},
  boxed title style={
      interior style={top color=white, bottom color=accent!5},
      frame hidden,
    },
  top=4pt,
  % borderline north removed for solid top rule matching bottom
  before skip=0pt,
  after skip=1.2em,
  #1
}

% Figure box style - "Floating Card" with Pop
\newtcolorbox{figurebox}[1][]{
  enhanced,
  boxrule=0pt,
  frame hidden,
  colback=white,
  borderline west={3pt}{0pt}{figline},
  arc=0pt,
  % Spacing
  left=15pt,
  right=15pt,
  top=10pt,
  bottom=10pt,
  before skip=0pt,
  after skip=0pt,
  #1
}

% Inter-environment decoupled text block
\colorlet{intertextline}{gray!40}
\colorlet{intertextback}{gray!12}
\newtcolorbox{intertextbox}[1][]{
  enhanced,
  breakable,
  boxrule=0pt,
  frame hidden,
  arc=0pt,
  left=10pt,
  right=0pt,
  top=8pt,
  bottom=8pt,
  before skip=0pt,
  after skip=0pt,
  mixable={intertextline}{intertextback},
  #1
}


% ==============================================================================
%                              Document Settings
% ==============================================================================
\setlength\parindent{0pt}

% --- Pružné mezery mezi odstavci ---------------------------------------------
% Pozor: dřív tu bylo rigidní \parskip{0.5em}, které přebilo pružnou hodnotu
% nastavenou u~\usepackage{parskip} výše. Rigidní mezera znamená, že stránka
% nemá \emph{žádnou} vůli --- buď se řádek vejde, nebo se celý přesune.
% Protože boxy mají before/after skip = 0pt, je právě \parskip tím, co je od
% sebe odděluje; pružnost se tedy propíše přímo do mezer mezi boxy.
% Se~ztrátou 0,25em na~mezeru a~~15 mezerami na~stránku získá sazeč zhruba
% 2 řádky vůle --- často přesně tolik, kolik chybí, aby se box vešel celý.
\setlength\parskip{0.5em plus 0.2em minus 0.25em}

% --- Penalty: kde se smí lámat stránka ----------------------------------------
% Penalta = cena zlomu v daném místě. Záporná = zlom je vítaný, 0 = neutrální,
% kladná = nežádoucí, >= 10000 = zakázáno, <= -10000 = vynuceno.
% TeX vybírá zlom s nejmenším součtem badness + penalty, takže tímhle se
% neurčuje zlom napevno, jen se posouvá jeho cena.
\clubpenalty=10000          % osiřelý PRVNÍ řádek odstavce dole na stránce
\widowpenalty=10000         % osamocený POSLEDNÍ řádek odstavce nahoře
\displaywidowpenalty=10000  % totéž kolem displayových rovnic
\brokenpenalty=9999         % nelámat stránku hned po~rozděleném slově
\interlinepenalty=150       % mírná daň za~zlom uvnitř odstavce:
% při shodné kvalitě raději zlom MEZI odstavci (tj. mezi boxy) než uvnitř.
% Schválně jen 150 --- vyšší hodnota by u~dlouhých boxů (Jak uspět, Shrnutí)
% bránila i~zlomům, které jsou nutné, a~vyráběla by podtečené stránky.

\gdef\afternestedbox{false}

% ==============================================================================
%                              Title Page
% ==============================================================================
\definecolor{titleblue}{HTML}{1FC4C4}
\definecolor{titledark}{HTML}{0F172A}

% Custom title page with geometric design
% Usage: \maketitlepage{Title}{Subtitle}{Author}{Date}
\newcommand{\maketitlepage}[4]{%
  \gdef\docname{#2 #1}%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    % Full light blue background (extended to avoid gaps)
    \fill[titleblue] ([xshift=-2mm,yshift=-2mm]current page.south west) rectangle ([xshift=2mm,yshift=2mm]current page.north east);

    % Subtle darker corner accent - bottom left
    \fill[titledark]
    (current page.south west) --
    ([yshift=8cm]current page.south west) --
      ([xshift=8cm]current page.south west) -- cycle;

    % Thin white geometric lines
    \draw[white, line width=1.5pt]
    ([xshift=3cm, yshift=3cm]current page.south west) --
      ([xshift=3cm, yshift=12cm]current page.south west) --
      ([xshift=12cm, yshift=3cm]current page.south west) -- cycle;

    % Small circle accent (top vertex of the white triangle)
    \fill[white] ([xshift=3cm, yshift=12cm]current page.south west) circle (5pt);

    % Title Content - aligned exactly 3cm from the right edge
    \node[anchor=north east, inner sep=0pt]
    at ([xshift=-3cm, yshift=-4cm]current page.north east) {
      \begin{minipage}{18cm}
        \raggedleft
        % Optical alignment: larger fonts have larger sidebearings, so we nudge it right slightly
        {\fontsize{64}{72}\selectfont\titlefont\bfseries\color{white}#2\hspace*{-0.04em}\par}
        \vspace{0.5cm}
        {\fontsize{32}{36}\selectfont\titlefont\color{white!90}#1\par}
        \vspace{3cm}
        {\fontsize{20}{24}\selectfont\titlefont\color{white!80}\bfseries#3\par}
        \vspace{0.5cm}
        {\fontsize{16}{18}\selectfont\titlefont\color{white!70}#4\par}
      \end{minipage}
    };
  \end{tikzpicture}%
  \newpage
  \setcounter{page}{1}%
}

